From a7863cf00db9ca4482c41e9e840e120c5a06c7df Mon Sep 17 00:00:00 2001
From: WilbertACDX <115293547+WilbertACDX@users.noreply.github.com>
Date: Sat, 12 Sep 2026 12:18:27 -0600
Subject: [PATCH] MSVC: build the slirp network path

Three portability gaps, none of them behavioural:

- Net_Slirp's Windows branches are gated on __WIN32__, which only MinGW
  defines. Everything they need (WSAPoll, the clock_gettime shim) is
  already written; MSVC just never saw it.
- libslirp's bundled glib shim calls __builtin_unreachable(), which MSVC
  does not have. __assume(0) means the same thing.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 src/net/Net_Slirp.cpp        | 10 +++++-----
 src/net/Net_Slirp.h          |  2 +-
 src/net/libslirp/glib/glib.h | 15 ++++++++++++++-
 3 files changed, 20 insertions(+), 7 deletions(-)

diff --git a/src/net/Net_Slirp.cpp b/src/net/Net_Slirp.cpp
index c36ba84..bd8d1a3 100644
--- a/src/net/Net_Slirp.cpp
+++ b/src/net/Net_Slirp.cpp
@@ -25,7 +25,7 @@
 
 #include <libslirp.h>
 
-#ifdef __WIN32__
+#if defined(__WIN32__) || defined(_WIN32)
 	#include <ws2tcpip.h>
 #else
 	#include <sys/socket.h>
@@ -47,7 +47,7 @@ const u32 kClientIP = kSubnet | 0x10;
 
 const u8 kServerMAC[6] = {0x00, 0xAB, 0x33, 0x28, 0x99, 0x44};
 
-#ifdef __WIN32__
+#if defined(__WIN32__) || defined(_WIN32)
 
 #define poll WSAPoll
 #ifndef CLOCK_MONOTONIC
@@ -68,7 +68,7 @@ int clock_gettime(int, struct timespec *spec)
     return 0;
 }
 
-#endif // __WIN32__
+#endif // Windows
 
 
 ssize_t Net_Slirp::SlirpCbSendPacket(const void* buf, size_t len, void* opaque) noexcept
@@ -412,12 +412,12 @@ int Net_Slirp::SlirpCbAddPoll(int fd, int events, void* opaque) noexcept
     if (events & SLIRP_POLL_IN) evt |= POLLIN;
     if (events & SLIRP_POLL_OUT) evt |= POLLWRNORM;
 
-#ifndef __WIN32__
+#if !defined(__WIN32__) && !defined(_WIN32)
     // CHECKME
     if (events & SLIRP_POLL_PRI) evt |= POLLPRI;
     if (events & SLIRP_POLL_ERR) evt |= POLLERR;
     if (events & SLIRP_POLL_HUP) evt |= POLLHUP;
-#endif // !__WIN32__
+#endif // !Windows
 
     self.PollList[idx].fd = fd;
     self.PollList[idx].events = evt;
diff --git a/src/net/Net_Slirp.h b/src/net/Net_Slirp.h
index 4dadd91..60422d1 100644
--- a/src/net/Net_Slirp.h
+++ b/src/net/Net_Slirp.h
@@ -26,7 +26,7 @@
 
 #include <libslirp.h>
 
-#ifdef __WIN32__
+#if defined(__WIN32__) || defined(_WIN32)
     #include <ws2tcpip.h>
 #else
     #include <poll.h>
diff --git a/src/net/libslirp/glib/glib.h b/src/net/libslirp/glib/glib.h
index f48993e..de50182 100644
--- a/src/net/libslirp/glib/glib.h
+++ b/src/net/libslirp/glib/glib.h
@@ -39,7 +39,13 @@ typedef ptrdiff_t ssize_t;
 #define GLIB_CHECK_VERSION(x, y, z) 1
 #define G_STATIC_ASSERT(...)
 #define g_assert assert
+/* __builtin_expect is a branch hint GCC and Clang accept and MSVC has no
+   equivalent for. Dropping it costs nothing but the hint. */
+#if defined(_MSC_VER) && !defined(__clang__)
+#define G_UNLIKELY(x) (x)
+#else
 #define G_UNLIKELY(x) __builtin_expect(x, 0)
+#endif
 
 #define g_return_if_fail(expr) \
     do {                       \
@@ -65,10 +71,17 @@ typedef ptrdiff_t ssize_t;
             g_warning("g_warn_if_fail: Expression '" #expr "' failed at " __FILE__ ":%d", __LINE__); \
     } while (false)
 
+/* MSVC has no __builtin_unreachable; __assume(0) says the same thing. */
+#if defined(_MSC_VER) && !defined(__clang__)
+#define slirp_unreachable() __assume(0)
+#else
+#define slirp_unreachable() __builtin_unreachable()
+#endif
+
 #define g_assert_not_reached() \
     do { \
         assert(false && "g_assert_not_reached"); \
-        __builtin_unreachable(); \
+        slirp_unreachable(); \
     } while (false)
 
 #define GLIB_SIZEOF_VOID_P 8
-- 
2.44.0.windows.1

