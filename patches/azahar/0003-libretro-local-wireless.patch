+// ---- multiemu patch: local wireless between two consoles -------------------
+//
+// Two 3DS consoles in one process, each a copy of this DLL with its own
+// globals. The first hosts a room on the loopback and joins it, the second
+// joins it too, and NWM_UDS -- the 3DS's local wireless -- carries their
+// packets through it. The same calls Azahar's Android frontend makes
+// (src/android/app/src/main/jni/multiplayer.cpp); a game must be loaded
+// first, since joining identifies the console by its ID.
+
+// Opens the room. False if it could not be bound (the port in use).
+extern "C" RETRO_API bool multiemu_room_host(unsigned port) {
+    auto room = Network::GetRoom().lock();
+    return room && room->Create("multiemu", "", "127.0.0.1", static_cast<u16>(port), "", 4, "", "",
+                                0, std::make_unique<Network::VerifyUser::NullBackend>(), {});
+}
+
+// Starts joining; the outcome shows up in multiemu_room_state.
+extern "C" RETRO_API void multiemu_room_join(unsigned port, const char* nickname) {
+    if (auto member = Network::GetRoomMember().lock()) {
+        member->Join(nickname, Service::CFG::GetConsoleIdHash(Core::System::GetInstance()),
+                     "127.0.0.1", static_cast<u16>(port), 0, Network::NoPreferredMac, "");
+    }
+}
+
+// Network::RoomMember::State: 3 is joined (4 the room's moderator), -1
+// before Network::Init.
+extern "C" RETRO_API int multiemu_room_state() {
+    auto member = Network::GetRoomMember().lock();
+    return member ? static_cast<int>(member->GetState()) : -1;
+}
+
+// How many consoles are in the room, as this one sees it.
+extern "C" RETRO_API int multiemu_room_members() {
+    auto member = Network::GetRoomMember().lock();
+    return member ? static_cast<int>(member->GetMemberInformation().size()) : 0;
+}
