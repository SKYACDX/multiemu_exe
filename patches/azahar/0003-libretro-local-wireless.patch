+// ---- multiemu patch: local wireless over Azahar's rooms --------------------
+//
+// NWM_UDS -- the 3DS's local wireless -- carries its packets through an
+// Azahar multiplayer room. Two uses: two consoles in one process (each a copy
+// of this DLL with its own globals; the first hosts a room on the loopback and
+// both join it), and one console joining a room server somewhere else, to
+// play with another PC or phone. The same calls Azahar's Android frontend
+// makes (src/android/app/src/main/jni/multiplayer.cpp), with one change:
+// see multiemu_room_join.
+
+// Opens the room. False if it could not be bound (the port in use).
+extern "C" RETRO_API bool multiemu_room_host(unsigned port) {
+    auto room = Network::GetRoom().lock();
+    return room && room->Create("multiemu", "", "127.0.0.1", static_cast<u16>(port), "", 4, "", "",
+                                0, std::make_unique<Network::VerifyUser::NullBackend>(), {});
+}
+
+// Why the last join failed or the connection dropped, as a
+// Network::RoomMember::Error; -1 when nothing has gone wrong since joining.
+static std::atomic<int> multiemu_room_last_error{-1};
+
+// Starts joining the room at host:port; the outcome shows up in
+// multiemu_room_state and multiemu_room_error. host may be a name.
+//
+// Azahar's frontends send Service::CFG::GetConsoleIdHash, a hash of the
+// emulated console's unique ID: the same value every time, for as long as
+// that NAND exists, so a room server could tell a player apart across
+// sessions. A room only compares it against the others in the room, to
+// refuse the same console twice, so this sends a new random one per join
+// instead -- which also means two copies of one console are no longer
+// refused. The game sees nothing of it; it gets its MAC from the room.
+extern "C" RETRO_API void multiemu_room_join(const char* host, unsigned port, const char* nickname,
+                                             const char* password) {
+    // Bound once per RoomMember: each retro_init makes a new one, and where
+    // the core stays loaded between games (Android) the old one is gone.
+    static std::weak_ptr<Network::RoomMember> bound;
+    if (auto member = Network::GetRoomMember().lock()) {
+        if (bound.lock() != member) {
+            bound = member;
+            member->BindOnError([](const Network::RoomMember::Error& error) {
+                multiemu_room_last_error = static_cast<int>(error);
+            });
+        }
+        multiemu_room_last_error = -1;
+        std::random_device random;
+        std::string console_id_hash;
+        for (int i = 0; i < 8; i++) {
+            console_id_hash += fmt::format("{:08x}", random());
+        }
+        member->Join(nickname, console_id_hash, host, static_cast<u16>(port), 0,
+                     Network::NoPreferredMac, password ? password : "");
+    }
+}
+
+extern "C" RETRO_API int multiemu_room_error() {
+    return multiemu_room_last_error;
+}
+
+extern "C" RETRO_API void multiemu_room_leave() {
+    if (auto member = Network::GetRoomMember().lock()) {
+        member->Leave();
+    }
+}
+
+// Network::RoomMember::State: 3 is joined (4 the room's moderator), -1
+// before Network::Init.
+extern "C" RETRO_API int multiemu_room_state() {
+    auto member = Network::GetRoomMember().lock();
+    return member ? static_cast<int>(member->GetState()) : -1;
+}
+
+// How many consoles are in the room, as this one sees it.
+extern "C" RETRO_API int multiemu_room_members() {
+    auto member = Network::GetRoomMember().lock();
+    return member ? static_cast<int>(member->GetMemberInformation().size()) : 0;
+}
